{
    "name": "flk",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "build": "tsc -b && vite build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint . --ext ts,tsx,js,jsx --report-unused-disable-directives --fix > nul 2>&1 || exit 0",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\" --loglevel silent",
        "stylelint": "stylelint \"src/**/*.{css,scss}\"",
        "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix --quiet > nul 2>&1 || exit 0",
        "preview": "vite preview",
        "prepare": "husky"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.9",
        "@hookform/resolvers": "^5.2.2",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-slider": "^1.3.6",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@radix-ui/react-visually-hidden": "^1.2.4",
        "@reduxjs/toolkit": "^2.12.0",
        "@tanstack/react-query": "^5.90.21",
        "@turf/turf": "^7.3.5",
        "@types/proj4": "^2.19.0",
        "axios": "^1.13.6",
        "clsx": "^2.1.1",
        "framer-motion": "^12.38.0",
        "geojson": "^0.5.0",
        "konva": "^10.3.0",
        "leaflet": "^1.9.4",
        "nanoid": "^5.1.6",
        "proj4": "^2.20.8",
        "proj4leaflet": "^1.0.2",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.71.2",
        "react-konva": "^19.2.4",
        "react-leaflet": "^5.0.0",
        "react-leaflet-cluster": "^4.0.0",
        "react-redux": "^9.3.0",
        "react-router-dom": "^7.13.1",
        "react-toastify": "^11.0.5",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/geojson": "^7946.0.16",
        "@types/leaflet": "^1.9.21",
        "@types/nanoid": "^3.0.0",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@types/react-leaflet": "^3.0.0",
        "@types/react-router-dom": "^5.3.3",
        "@typescript-eslint/parser": "^8.56.1",
        "@vitejs/plugin-react": "^5.1.1",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.3.1",
        "prettier": "^3.8.1",
        "prettier-plugin-style-order": "^0.2.2",
        "stylelint": "^17.4.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-order": "^7.0.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.48.0",
        "vite": "^7.3.1"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,scss}": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    }
}
